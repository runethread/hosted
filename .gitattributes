# Keep project-controlled text byte-stable across developer platforms.
* text=auto eol=lf

# Wrangler runtime declarations are generated bytes. Preserve them verbatim while
# keeping the other default whitespace checks active for this path.
worker-configuration.d.ts whitespace=-blank-at-eol,blank-at-eof,space-before-tab

# Common binary artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
