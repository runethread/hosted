{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runethread-hosted-journal-r2-provider-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "PROVIDER_PROOF_BUCKET",
      "bucket_name": "runethread-provider-proof",
      "remote": true
    }
  ]
}
